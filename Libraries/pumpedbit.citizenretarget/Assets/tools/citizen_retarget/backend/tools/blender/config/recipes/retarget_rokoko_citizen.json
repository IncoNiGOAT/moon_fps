{
  "recipeId": "retarget_rokoko_citizen_v1",
  "description": "Headless Rokoko-backed retarget from Quaternius actions to stock citizen_REF.",
  "sourceProfile": "quaternius_ual2",
  "targetProfile": "citizen",
  "debug": {
    "enabled": true,
    "saveIntermediateBlendFiles": false,
    "saveStageMetrics": true
  },
  "stages": [
    {
      "id": "import_fbx",
      "enabled": true,
      "kind": "core",
      "config": {
        "automaticBoneOrientation": false,
        "animOffset": 0.0
      }
    },
    {
      "id": "collect_source_metadata",
      "enabled": true,
      "kind": "validator",
      "config": {
        "sourcePreparationMode": "ual_remove_z_180"
      }
    },
    {
      "id": "validate_import",
      "enabled": true,
      "kind": "validator",
      "config": {
        "requireSingleArmature": true,
        "requireSelectedAction": true,
        "requireRootBone": true
      }
    },
    {
      "id": "load_target_reference",
      "enabled": true,
      "kind": "core",
      "config": {
        "targetReferencePath": ""
      }
    },
    {
      "id": "collect_target_metadata",
      "enabled": true,
      "kind": "validator",
      "config": {}
    },
    {
      "id": "align_rest_pose",
      "enabled": true,
      "kind": "normalization",
      "config": {}
    },
    {
      "id": "build_bone_map",
      "enabled": true,
      "kind": "retarget",
      "config": {
        "requiredSlots": [
          "pelvis",
          "spine_0",
          "spine_1",
          "spine_2",
          "head",
          "arm_upper_L",
          "arm_lower_L",
          "hand_L",
          "arm_upper_R",
          "arm_lower_R",
          "hand_R",
          "leg_upper_L",
          "leg_lower_L",
          "ankle_L",
          "ball_L",
          "leg_upper_R",
          "leg_lower_R",
          "ankle_R",
          "ball_R"
        ]
      }
    },
    {
      "id": "normalize_retarget_pose",
      "enabled": true,
      "kind": "normalization",
      "config": {
        "targetPosePresetId": "citizen_t_pose_calibrated_v1"
      }
    },
    {
      "id": "retarget_to_citizen",
      "enabled": true,
      "kind": "retarget",
      "config": {
        "retargetBackend": "rokoko_operator",
        "applyRequiredBoneMapOverrides": true,
        "autoScaling": false,
        "usePose": "CURRENT",
        "sourceObjectBasisMode": "preserve",
        "sourceObjectBasisToleranceDegrees": 0.5
      }
    },
    {
      "id": "bake_target_animation",
      "enabled": true,
      "kind": "retarget",
      "config": {}
    },
    {
      "id": "rebuild_citizen_ik",
      "enabled": true,
      "kind": "retarget",
      "config": {
        "enabledTargets": [
          "foot_R_IK_target",
          "foot_L_IK_target",
          "hand_R_IK_target",
          "hand_L_IK_target"
        ]
      }
    },
    {
      "id": "analyze_motion_trajectories",
      "enabled": true,
      "kind": "validator",
      "config": {
        "referenceSlot": "pelvis",
        "trackedSlots": [
          "hand_L",
          "hand_R",
          "ankle_L",
          "ankle_R"
        ],
        "requiredDominantAxisMatchSlots": [
          "hand_L",
          "hand_R"
        ],
        "minTargetAnkleAlternationSignChanges": 2,
        "failOnDominantAxisMismatch": false,
        "failOnWeakAnkleAlternation": false
      }
    },
    {
      "id": "validate_target_animation",
      "enabled": true,
      "kind": "validator",
      "config": {
        "staticBoneGroups": [
          "twist",
          "helper",
          "log_only"
        ]
      }
    },
    {
      "id": "export_fbx",
      "enabled": true,
      "kind": "core",
      "config": {
        "globalScale": 1.0,
        "axisForward": "-Z",
        "axisUp": "Y",
        "primaryBoneAxis": "Y",
        "secondaryBoneAxis": "X",
        "applyUnitScale": true,
        "useArmatureDeformOnly": false,
        "addLeafBones": false,
        "bakeAnim": true,
        "bakeAnimUseAllBones": false,
        "bakeAnimUseAllActions": false,
        "bakeAnimUseNlaStrips": false,
        "bakeAnimSimplifyFactor": 0.0
      }
    },
    {
      "id": "validate_export",
      "enabled": true,
      "kind": "validator",
      "config": {
        "exactBoneCount": true,
        "exactFrameRange": true,
        "exactAnimatedBoneSet": false,
        "exactBoneNameSet": true,
        "checkLeafBoneInjection": true,
        "checkRootPathDrift": true,
        "rootDriftAbsoluteTolerance": 0.01,
        "rootDriftRelativeTolerance": 0.001
      }
    },
    {
      "id": "write_result_manifest",
      "enabled": true,
      "kind": "core",
      "config": {}
    }
  ]
}
