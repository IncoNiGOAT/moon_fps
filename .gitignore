
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
obj
bin
Properties/*
code/obj/*
code/Properties/*

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
# Compilés s&box requis pour la map + modèles citizen (sinon hiérarchie Map vide / anims cassées)
!Assets/maps/mapv1.vmdl_c
!Assets/models/citizen_custom/citizen_retarget.vmdl_c
!Assets/models/citizen_custom/citizen_citizen_target.vmdl_c
!Assets/models/citizen_custom/citizen_retarget/head_lod0_vmorf.vtex_c
!Assets/models/citizen_custom/citizen_citizen_target/head_lod0_vmorf.vtex_c
*.los
*.vpk
# Paquet map Hammer nécessaire pour que MapInstance crée WorldSpawn / WorldPhysics chez les autres clones
!Assets/maps/*.vpk
*launchSettings.json
*.sln
*.slnx

*idea

# Exported / standalone games
Exports/

# Outils / caches locaux
.tmp/
[Tt]humbs.db
*.user
*.userosscache
