
# This file describes files and paths that should not be tracked by Git version control
# https://git-scm.com/docs/gitignore

# Auto-generated code editor files
.vs/*
.vscode/*
*.csproj
obj
bin
Properties/*
code/obj/*
code/Properties/*

# Auto-generated asset related files
.sbox/*
*.generated.*
*.*_c
!*.shader_c
*.los
*.vpk
# Cartes du projet : les .vpk sous Assets/maps doivent rester versionnés (chargement MapInstance).
!Assets/maps/**/*.vpk
*launchSettings.json
*.sln
*.slnx

*idea

# Exported / standalone games
Exports/

# Outils / caches locaux
.tmp/
[Tt]humbs.db
*.user
*.userosscache
